{
  "name": "ed4u",
  "version": "0.1.0",
  "private": true,
  "description": "ED4U school operating platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @ed4u/web",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start -w @ed4u/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "verify": "node scripts/verify.mjs",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down",
    "benchmark:mentor": "npm run benchmark -w @ed4u/mentor-engine && node scripts/copy-mentor-benchmark.mjs",
    "benchmark:facility": "npm run benchmark -w @ed4u/facility-engine",
    "benchmark:mentor:smoke": "npm run benchmark:smoke -w @ed4u/mentor-engine && node scripts/copy-mentor-benchmark.mjs",
    "benchmark:facility:smoke": "npm run benchmark:smoke -w @ed4u/facility-engine",
    "db:demo:reset": "prisma migrate reset --force --skip-seed && npm run db:seed"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.0",
    "argon2": "^0.44.0",
    "dotenv": "^16.6.1",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "prisma": "^7.9.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "allowScripts": {
    "argon2@0.44.0": true,
    "prisma@7.9.1": true,
    "@prisma/engines@7.9.1": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "sharp@0.34.5": true
  }
}
