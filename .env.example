# ED4U local development. Copy to .env and .env.local
# Never commit real secrets.

DATABASE_URL="postgresql://ed4u:ed4u_local@127.0.0.1:5434/ed4u"
SESSION_SECRET="change-me-to-a-32-byte-or-longer-random-string"
NODE_ENV="development"

# Development-only. When "true", seeded DEMO_* accounts skip the first-login
# password gate so judges can browse quickly. Default (unset/false) always
# forces a password change on first login with the temporary password.
DEMO_SKIP_PASSWORD_CHANGE="false"

# Optional LLM for natural-language facility parsing. Manual + deterministic
# parser always work when this is empty.
OPENAI_API_KEY=""
