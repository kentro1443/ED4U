{
  "name": "@ed4u/facility-engine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Deterministic, explainable facility planning engine for ED4U. Does not query Prisma.",
  "main": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "benchmark": "tsx scripts/benchmark.ts",
    "benchmark:smoke": "tsx scripts/benchmark.ts --smoke"
  },
  "dependencies": {
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.31.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.37.0",
    "vitest": "^3.2.4"
  }
}
